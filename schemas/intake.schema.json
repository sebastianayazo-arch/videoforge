{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://videoforge/schemas/intake.schema.json",
  "title": "Intake",
  "description": "Respuestas del cuestionario (Módulo 4) que alimentan el script-engine.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "objective",
    "platforms",
    "audience",
    "productAngle",
    "cta",
    "durationSec",
    "market",
    "paid",
    "adPlatforms",
    "ratios"
  ],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["tiktok", "instagram", "youtube", "meta"] }
    },
    "audience": { "type": "string", "minLength": 1 },
    "productAngle": { "type": "string", "minLength": 1 },
    "cta": { "type": "string", "minLength": 1 },
    "durationSec": { "type": "number", "exclusiveMinimum": 0 },
    "restrictions": { "type": "string" },
    "market": { "enum": ["CO", "MX", "US-latino", "other"] },
    "paid": { "type": "boolean" },
    "adPlatforms": {
      "type": "array",
      "items": { "enum": ["tiktok", "instagram", "youtube", "meta"] }
    },
    "ratios": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["9:16", "4:5", "1:1"] }
    }
  }
}
